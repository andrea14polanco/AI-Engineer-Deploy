venv/
.venv/

# Environment / secrets — NUNCA al image
.env
*.env
.env.*

# Git
.git/
.gitignore

# IDE and editor directories
.idea/
.vscode/

# Build directories
build/
dist/

# Logs
*.log

# Coverage reports
*.coverage
.coverage
htmlcov/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Miscellaneous
*.swp

# System files
.DS_Store

# Python bytecode files
*.pyc

# C extensions
*.so

# Backup files
*~

# Temporary files
*.tmp

# Documentation build directories
docs/_build/

# Dockerfile itself doesn't need to be in the image
../Dockerfile
.dockerignore
